{
  "name": "reciplease-web",
  "engines": {
    "node": ">=24"
  },
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src e2e",
    "codegen:types": "openapi-typescript ${BACKEND_URL:-http://localhost:8080}/openapi -o src/types/generated/api.ts",
    "codegen:orval": "orval --config orval.config.ts",
    "check": "npm run typecheck && npm run lint",
    "build": "node scripts/set-version.mjs && npm run codegen:types && npm run codegen:orval && npm run check && next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@types/node": "^22.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@zxing/browser": "^0.2.0",
    "@zxing/library": "^0.22.0",
    "google-auth-library": "^10.9.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.62.1",
    "swr": "^2.5.1",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "eslint": "^9.9.0",
    "eslint-config-next": "^16.3.3",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "netlify-plugin-cypress": "~2.2.1",
    "openapi-typescript": "^7.13.0",
    "orval": "^8.27.0",
    "postcss": "^8.5.15",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.0",
    "ts-jest": "^29.4.11"
  }
}
