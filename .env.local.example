BACKEND_URL=http://localhost:8080

# Local dev only. Pick one:
#   NEXT_PUBLIC_AUTH_DISABLED=true  - bypass auth entirely (no session).
#   NEXT_PUBLIC_FAKE_AUTH=true      - inject a fake signed-in session
#                                     (user@reciplease.org) so the authenticated
#                                     UI is reachable without Google. Skips the
#                                     middleware gate and backend allowlist probe.
# NEXT_PUBLIC_FAKE_AUTH=true

# NextAuth (Google login). See README / Google Cloud Console > Credentials.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# Used to encrypt the session JWT. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret
# The canonical URL of this app (no trailing slash).
NEXTAUTH_URL=http://localhost:3000
