BACKEND_URL=http://localhost:8080

# Local dev only. Pick one:
#   NEXT_PUBLIC_AUTH_DISABLED=true  - bypass auth entirely (no session).
#   NEXT_PUBLIC_FAKE_AUTH=true      - inject a fake signed-in session
#                                     (user@reciplease.org) so the authenticated
#                                     UI is reachable without Google. Skips the
#                                     middleware gate and backend allowlist probe.
# NEXT_PUBLIC_FAKE_AUTH=true

# NextAuth (Google login). See README / Google Cloud Console > Credentials.
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# NextAuth (GitHub login). See README / GitHub > Settings > Developer settings
# > OAuth Apps.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# Used to encrypt the session JWT. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-random-secret
# The canonical URL of this app (no trailing slash).
NEXTAUTH_URL=http://localhost:3000
# Shared secret with the backend for POST /api/auth/exchange (sent as
# X-Internal-Secret). Must match the backend's RECIPLEASE_JWT_SIGNING_SECRET.
RECIPLEASE_JWT_SIGNING_SECRET=generate-a-random-secret

# Fitbit account linking (OAuth2 + PKCE). See Settings > Fitbit, and
# https://dev.fitbit.com/apps for registering an app. FITBIT_REDIRECT_URI must
# exactly match the callback URL registered with Fitbit; defaults to
# `${NEXTAUTH_URL}/api/fitbit/callback` if unset.
FITBIT_CLIENT_ID=your-fitbit-client-id
# FITBIT_REDIRECT_URI=http://localhost:3000/api/fitbit/callback
